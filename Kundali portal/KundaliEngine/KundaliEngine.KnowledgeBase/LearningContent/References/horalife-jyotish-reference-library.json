{
  "schemaVersion": "1.0.0",
  "libraryId": "horalife-jyotish-reference-library",
  "title": "Learning by HoraLife — Jyotish Reference Library",
  "description": "Controlled source registry for authentic Jyotish course content. Session JSON files must cite sourceId and editionId and must not invent verses, chapter numbers, translations or doctrinal claims.",
  "defaultLanguage": "en",
  "supportedLanguages": ["en", "hi", "kn"],
  "governance": {
    "sourcePriority": [
      "Original Sanskrit text from a recognised classical work",
      "Established Sanskrit-English or Sanskrit-Hindi edition",
      "Second classical text used for cross-verification",
      "Modern explanatory work used only for teaching clarity",
      "Original HoraLife learner-friendly explanation"
    ],
    "verificationStatuses": [
      {"id": "unverified", "meaning": "Located but not checked against the scanned source page."},
      {"id": "single-edition-verified", "meaning": "Checked against one identified edition."},
      {"id": "cross-edition-verified", "meaning": "Checked against two editions or one edition plus a reliable critical reference."},
      {"id": "editor-reviewed", "meaning": "Cross-verified and approved for publication by the HoraLife content reviewer."}
    ],
    "mandatoryRules": [
      "Never generate or reconstruct a Sanskrit verse from memory.",
      "Never assign a chapter or verse number unless it has been checked in the cited edition.",
      "Record edition details because chapter and verse numbering may differ between editions.",
      "Store Sanskrit, transliteration, literal meaning and HoraLife explanation separately.",
      "Do not describe every classical Jyotisha verse as Vedic.",
      "Use the label Vedic source only for a genuinely Vedic text.",
      "Label BPHS, Phaladeepika, Brihat Jataka, Saravali and Jataka Parijata as classical Jyotisha sources.",
      "When authorities disagree, present the difference instead of silently choosing one rule.",
      "Avoid lengthy reproduction of modern copyrighted translations; quote briefly and paraphrase.",
      "A session may contain zero, one or at most two shloka references, collapsed by default."
    ],
    "requiredCitationFields": [
      "sourceId", "editionId", "chapterTitle", "chapterNumberAsPrinted",
      "verseNumberAsPrinted", "pageNumber", "supports", "verificationStatus", "verifiedOn"
    ],
    "shlokaDisplayPolicy": {
      "maximumPerSession": 2,
      "defaultDisplayMode": "collapsed",
      "uiLabel": "Classical Reference",
      "icon": "om",
      "requiredFields": [
        "sanskrit", "transliteration", "literalMeaning", "learnerMeaning", "sourceCitation", "relevance"
      ]
    }
  },
