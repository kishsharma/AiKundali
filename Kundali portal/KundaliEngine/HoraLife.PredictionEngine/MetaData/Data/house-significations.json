  "classificationDefinitions": [
    {
      "key": "Kendra",
      "name": "Kendra",
      "houses": [ 1, 4, 7, 10 ],
      "aliases": [ "Angular" ],
      "traditionalAssociations": [ "Vishnu Sthana" ],
      "meaning": "Angular houses forming the principal structural pillars of the horoscope.",
      "sourceRefs": [ "BPHS" ]
    },
    {
      "key": "Kona",
      "name": "Kona",
      "houses": [ 5, 9 ],
      "aliases": [ "Trine" ],
      "traditionalAssociations": [],
      "meaning": "The fifth and ninth houses from the ascendant, explicitly identified as trinal houses.",
      "sourceRefs": [ "BPHS" ]
    },
    {
      "key": "DharmaTrikona",
      "name": "Dharma Trikona",
      "houses": [ 1, 5, 9 ],
      "aliases": [ "Dharma Houses" ],
      "traditionalAssociations": [ "Lakshmi Sthana" ],
      "meaning": "The Dharma group representing self, intelligence or merit, and dharma or fortune.",
      "sourceRefs": [ "TRADITIONAL_JYOTISHA" ]
    },
    {
      "key": "ArthaTrikona",
      "name": "Artha Trikona",
      "houses": [ 2, 6, 10 ],
      "aliases": [ "Artha Houses" ],
      "traditionalAssociations": [],
      "meaning": "The Artha group concerning resources, service or obligations, and worldly action or profession.",
      "sourceRefs": [ "TRADITIONAL_JYOTISHA" ]
    },
    {
      "key": "KamaTrikona",
      "name": "Kama Trikona",
      "houses": [ 3, 7, 11 ],
      "aliases": [ "Kama Houses" ],
      "traditionalAssociations": [],
      "meaning": "The Kama group concerning initiative, relationships and partnerships, and fulfilment of desires.",
      "sourceRefs": [ "TRADITIONAL_JYOTISHA" ]
    },
    {
      "key": "MokshaTrikona",
      "name": "Moksha Trikona",
      "houses": [ 4, 8, 12 ],
      "aliases": [ "Moksha Houses" ],
      "traditionalAssociations": [],
      "meaning": "The Moksha group concerning inner happiness, transformation, release and withdrawal.",
      "sourceRefs": [ "TRADITIONAL_JYOTISHA" ]
    },
    {
      "key": "Panaphara",
      "name": "Panaphara",
      "houses": [ 2, 5, 8, 11 ],
      "aliases": [ "Succedent" ],
      "traditionalAssociations": [],
      "meaning": "Houses succeeding the Kendras.",
      "sourceRefs": [ "BPHS" ]
    },
    {
      "key": "Apoklima",
      "name": "Apoklima",
      "houses": [ 3, 6, 9, 12 ],
      "aliases": [ "Cadent" ],
      "traditionalAssociations": [],
      "meaning": "Houses following the Panapharas.",
      "sourceRefs": [ "BPHS" ]
    },
    {
      "key": "Upachaya",
      "name": "Upachaya",
      "houses": [ 3, 6, 10, 11 ],
      "aliases": [ "Growth Houses" ],
      "traditionalAssociations": [],
      "meaning": "Houses whose matters can develop through time, effort, experience and growth.",
      "sourceRefs": [ "BPHS" ]
    },
    {
      "key": "Trika",
      "name": "Trika",
      "houses": [ 6, 8, 12 ],
      "aliases": [ "Dusthana" ],
      "traditionalAssociations": [],
      "meaning": "Houses associated with difficulty, disruption, adjustment, loss or transformation.",
      "sourceRefs": [ "BPHS" ]
    },
    {
      "key": "Chaturasra",
      "name": "Chaturasra",
      "houses": [ 4, 8 ],
      "aliases": [],
      "traditionalAssociations": [],
      "meaning": "The fourth and eighth houses forming the Chaturasra grouping.",
      "sourceRefs": [ "BPHS" ]
    },
    {
      "key": "Maraka",
      "name": "Maraka",
      "houses": [ 2, 7 ],
      "aliases": [ "Maraka Sthana" ],
      "traditionalAssociations": [],
      "meaning": "The second and seventh houses traditionally considered Maraka positions in longevity analysis.",
      "sourceRefs": [ "TRADITIONAL_JYOTISHA" ]
    }
  ],

  "purusharthaDefinitions": [
    {
      "key": "Dharma",
      "houses": [ 1, 5, 9 ],
      "meaning": "Purpose, principles, right action, learning and dharmic development."
    },
    {
      "key": "Artha",
      "houses": [ 2, 6, 10 ],
      "meaning": "Resources, material support, work, responsibility and worldly accomplishment."
    },
    {
      "key": "Kama",
      "houses": [ 3, 7, 11 ],
      "meaning": "Desire, interaction, relationships, initiative and fulfilment."
    },
    {
      "key": "Moksha",
      "houses": [ 4, 8, 12 ],
      "meaning": "Inner life, transformation, withdrawal, release and liberation."
    }
  ],

