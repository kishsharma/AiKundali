  "item": [
    {
      "name": "Cart",
      "item": [
        {
          "name": "Add Cart Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/store/cart/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "store",
                "cart",
                "items"
              ]
            },
            "description": "Adds a product variant and stores cartId/cartItemId automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"variantId\": \"{{variantId}}\",\n  \"quantity\": {{addQuantity}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Cart response is valid', function () {",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('currency', 'INR');",
                  "  pm.expect(body).to.have.property('items').that.is.an('array');",
                  "});",
                  "const productId = pm.collectionVariables.get('productId');",
                  "const variantId = pm.collectionVariables.get('variantId');",
                  "const item = body.items.find(x => x.productId === productId && x.variantId === variantId);",
                  "pm.test('Added item exists', function () { pm.expect(item).to.exist; });",
                  "if (body.id) pm.collectionVariables.set('cartId', body.id);",
                  "if (item && item.id) pm.collectionVariables.set('cartItemId', item.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/store/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "store",
                "cart"
              ]
            },
            "description": "Returns the authenticated user's active cart."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Cart structure is valid', function () {",
                  "  pm.expect(body).to.have.property('currency');",
                  "  pm.expect(body).to.have.property('totalQuantity');",
                  "  pm.expect(body).to.have.property('subtotal');",
                  "  pm.expect(body).to.have.property('items').that.is.an('array');",
                  "});",
                  "const item = body.items.find(x => x.productId === pm.collectionVariables.get('productId') && x.variantId === pm.collectionVariables.get('variantId'));",
                  "if (body.id) pm.collectionVariables.set('cartId', body.id);",
                  "if (item && item.id) pm.collectionVariables.set('cartItemId', item.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Same Variant Again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/store/cart/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "store",
                "cart",
                "items"
              ]
            },
            "description": "Adds the same variant again; existing item quantity should increase.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"variantId\": \"{{variantId}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const productId = pm.collectionVariables.get('productId');",
                  "const variantId = pm.collectionVariables.get('variantId');",
                  "const matches = body.items.filter(x => x.productId === productId && x.variantId === variantId);",
                  "pm.test('No duplicate cart item is created', function () { pm.expect(matches.length).to.eql(1); });",
                  "pm.test('Quantity increased', function () { pm.expect(matches[0].quantity).to.be.above(1); });",
                  "if (matches.length === 1) pm.collectionVariables.set('cartItemId', matches[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/store/cart/items/{{cartItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "store",
                "cart",
                "items",
                "{{cartItemId}}"
              ]
            },
            "description": "Updates the current cart item quantity.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": {{updateQuantity}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const item = body.items.find(x => x.id === pm.collectionVariables.get('cartItemId'));",
                  "const expected = Number(pm.collectionVariables.get('updateQuantity'));",
                  "pm.test('Quantity updated', function () { pm.expect(item).to.exist; pm.expect(item.quantity).to.eql(expected); });",
                  "pm.test('Line total is correct', function () { pm.expect(item.lineTotal).to.eql(item.unitPrice * item.quantity); });"
                ]
              }
            }
          ]
        },
